+// Create or remove an administrator account. This is the ONLY way an admin comes to exist: no HTTP route can grant it.
+//   node scripts/make-admin.mjs <username> [--name "Display name"] [--out creds.md]   create a new admin
+//   node scripts/make-admin.mjs --revoke <username>                                  turn an admin back into an ordinary account
+//   node scripts/make-admin.mjs --list                                               list admins
+// Run it through deploy/make-admin.sh on the VM (as the leakproof user, keys on tmpfs). The new admin must set their own passphrase at
+// first login, so the printed one (which the operator saw) stops working. --out writes it to a 0600 file instead of printing it.
+import fs from 'node:fs';
+import { loadConfig, loadKey } from '../src/config.mjs';
+import { openDb } from '../src/db.mjs';
+import { createApp } from '../src/app.mjs';
+
+const args = process.argv.slice(2);
+const opt = (name) => { const i = args.indexOf(name); return i < 0 ? null : (args[i + 1] ?? ''); };
+const usage = () => { console.error('usage: node scripts/make-admin.mjs <username> [--name "Display"] [--out file] | --revoke <username> | --list'); process.exit(2); };
+
+const config = loadConfig();
+const db = openDb(config.dataDir);
+const app = createApp({ db, config, maintenance: true, serverKey: loadKey(config.keyDir, 'server.key', db), logKey: loadKey(config.keyDir, 'log.key', db) });
+const admins = () => db.prepare('SELECT username, display, disabled, last_login FROM accounts WHERE is_admin = 1 ORDER BY created').all();
+
+if (args.includes('--list')) {
+  for (const a of admins()) console.log(`${a.username}\t${a.display}${a.disabled ? '\t(disabled)' : ''}\t${a.last_login ? new Date(a.last_login).toISOString() : 'never logged in'}`);
+  if (!admins().length) console.log('no administrators');
+} else if (args.includes('--revoke')) {
+  const name = opt('--revoke')?.toLowerCase();
+  if (!name || name.startsWith('--')) usage();
+  const row = db.prepare('SELECT id FROM accounts WHERE username = ? AND is_admin = 1').get(name);
+  if (!row) { console.error(`${name} is not an administrator`); process.exit(1); }
+  db.prepare('UPDATE accounts SET is_admin = 0 WHERE id = ?').run(row.id);
+  db.prepare('DELETE FROM sessions WHERE account_id = ?').run(row.id);
+  app.log.append('admin', 'operator', 'admin.revoked', { target: row.id, name });
+  console.log(`${name} is no longer an administrator`);
+} else {
+  const outAt = args.indexOf('--out'), nameAt = args.indexOf('--name');
+  const flagValues = new Set([outAt, nameAt].filter((i) => i >= 0).map((i) => i + 1)); // an absent flag must not exclude argument 0
+  const username = args.find((a, i) => !a.startsWith('--') && !flagValues.has(i))?.toLowerCase();
+  if (!username || !/^[a-z0-9][a-z0-9_.-]{2,31}$/.test(username) || username.startsWith('sim-')) {
+    console.error('username must be 3 to 32 lowercase letters, digits, dot, dash or underscore'); usage();
+  }
+  if (outAt >= 0 && (!args[outAt + 1] || args[outAt + 1].startsWith('--'))) usage();
+  if (['system', 'operator', 'admin', 'root', 'administrator'].includes(username)) { console.error(`${username} is reserved: pick a name such as ${username}-ops`); process.exit(1); }
+  if (db.prepare('SELECT 1 FROM accounts WHERE username = ?').get(username)) { console.error(`${username} already exists; admins are always new, dedicated accounts`); process.exit(1); }
+  const display = opt('--name') || 'Administrator';
+  const acc = await app.createAccount(username, display, { admin: true, mustChange: true });
+  app.log.append('admin', 'operator', 'admin.granted', { target: acc.id, name: username });
+  if (outAt >= 0) {
+    fs.writeFileSync(args[outAt + 1], `| username | passphrase | recovery code |\n|---|---|---|\n| ${username} | ${acc.passphrase} | ${acc.recovery} |\n`, { mode: 0o600 });
+    fs.chmodSync(args[outAt + 1], 0o600);
+    console.log(`Administrator ${username} created. Credentials written to ${args[outAt + 1]} (mode 0600).`);
+  } else {
+    console.log(`Administrator ${username} created.\n  passphrase: ${acc.passphrase}\n  recovery code: ${acc.recovery}\n  (first login asks for a new passphrase; this one then stops working)`);
+  }
+}
+db.close();
