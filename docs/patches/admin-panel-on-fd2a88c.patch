+test('A14 [SR16] two writers appending to the log at the same time never fork the chain', async () => {
+  const { Worker } = await import('node:worker_threads');
+  const fs = await import('node:fs'), os = await import('node:os'), path = await import('node:path');
+  const { openDb } = await import('../src/db.mjs'); const { makeLog } = await import('../src/log.mjs');
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'lp-fork-'));
+  const key = 'ab'.repeat(32);
+  const db = openDb(dir);
+  try {
+    const url = new URL('./log-worker.mjs', import.meta.url);
+    const workers = [1, 2, 3].map((who) => new Worker(url, { workerData: { dir, key, n: 250, who: 'w' + who } }));
+    await Promise.all(workers.map((w) => new Promise((res) => w.once('message', res))));
+    const done = Promise.all(workers.map((w) => new Promise((res, rej) => { w.once('message', res); w.once('error', rej); })));
+    workers.forEach((w) => w.postMessage('go'));
+    await done;
+    const log = makeLog(db, Buffer.from(key, 'hex'));
+    const v = log.verify();
+    assert.equal(v.entries, 750); assert.equal(v.ok, true, `chain forked at entry ${v.brokenAt}`);
+  } finally { db.close(); fs.rmSync(dir, { recursive: true, force: true }); }
+});
