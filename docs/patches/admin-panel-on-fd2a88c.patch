+// Helper for tests/admin.test.mjs: a second process-like writer (a worker thread with its own database connection) appending to the same log.
+import { parentPort, workerData } from 'node:worker_threads';
+import { openDb } from '../src/db.mjs';
+import { makeLog } from '../src/log.mjs';
+
+const db = openDb(workerData.dir);
+const log = makeLog(db, Buffer.from(workerData.key, 'hex'));
+parentPort.postMessage('ready');
+parentPort.once('message', () => {
+  for (let i = 0; i < workerData.n; i++) log.append('E', workerData.who, 'copy.printed', { seat: i, fetch: 1 });
+  db.close();
+  parentPort.postMessage('done');
+});
