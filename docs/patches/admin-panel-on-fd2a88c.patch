@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# Create, list or revoke an administrator for one instance. M2 runs it:
+#   sudo bash deploy/make-admin.sh practice create alice-admin [--out /root/admin-slip.md]
+#   sudo bash deploy/make-admin.sh practice list
+#   sudo bash deploy/make-admin.sh practice revoke alice-admin
+# What it changes: runs scripts/make-admin.mjs against /var/lib/leakproof/<instance> as the leakproof user, with that instance's keys
+# copied to a tmpfs directory for the duration of the run only. Safe while the service runs. create writes the credentials to --out
+# (default /root/admin-<name>-<time>.md, root, 0600) and prints NO passphrase. The admin must choose their own passphrase at first
+# login. Admins exist only this way: no web page or API can grant the role.
+# Undo: revoke. The admin panel is at https://<VM>:8443/#/admin once logged in as an admin.
+set -euo pipefail
+case "${1:-}" in --help|-h) sed -n '2,/^set -/{/^set -/!p;}' "$0"; exit 0 ;; esac
+[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 2; }
+INST="${1:?usage: make-admin.sh <practice|demo|official> <create|list|revoke> [username] [--out FILE]}"
+ACT="${2:?usage: make-admin.sh <instance> <create|list|revoke> [username] [--out FILE]}"
+case "$INST" in practice|demo|official) ;; *) echo "instance must be practice, demo or official" >&2; exit 2 ;; esac
+MODE=practice; [ "$INST" = practice ] || MODE=official
+CUR=/srv/leakproof/current; DATA="/var/lib/leakproof/$INST"
+[ -f "$CUR/scripts/make-admin.mjs" ] || { echo "this release has no scripts/make-admin.mjs: deploy a newer tag" >&2; exit 1; }
+[ -f "$DATA/leakproof.db" ] || { echo "$DATA has no database yet: start the instance once first" >&2; exit 1; }
+W="$(mktemp -d /run/lp-admin.XXXXXX)"; trap 'rm -rf "$W"' EXIT
+chown leakproof:leakproof "$W"; chmod 0700 "$W"; install -d -o leakproof -g leakproof -m 0700 "$W/keys"
+for k in server.key log.key; do install -o leakproof -g leakproof -m 0400 "/etc/leakproof/$INST/$k" "$W/keys/$k"; done
+run() { runuser -u leakproof -- env LP_MODE="$MODE" LP_INSTANCE="$INST" LP_DATA_DIR="$DATA" LP_KEY_DIR="$W/keys" \
+  node --disable-warning=ExperimentalWarning "$CUR/scripts/make-admin.mjs" "$@"; }
+case "$ACT" in
+  list) run --list ;;
+  revoke) run --revoke "${3:?username}" ;;
+  create)
+    NAME="${3:?username}"; shift 3
+    OUTF="/root/admin-$NAME-$(date +%Y%m%d-%H%M%S).md"
+    while [ $# -gt 0 ]; do case "$1" in --out) OUTF="${2:?}"; shift 2 ;; *) echo "unknown option $1" >&2; exit 2 ;; esac; done
+    run "$NAME" --out "$W/slip.md"
+    install -m 0600 -o root -g root "$W/slip.md" "$OUTF"
+    echo "Credentials: $OUTF (root only). Give them to the administrator in person; they must set their own passphrase at first login." ;;
+  *) echo "action must be create, list or revoke" >&2; exit 2 ;;
+esac
