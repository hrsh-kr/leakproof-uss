+// The admin panel: see everything the operator needs, remove abusers, and nothing more.
+// Admin accounts are made only by the operator on the VM (scripts/make-admin.mjs), never over HTTP.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { boot, practiceUser, sealAndVerify, releaseOpen } from './helpers.mjs';
+
+async function adminOf(t, name = 'boss') {
+  const a = await t.app.createAccount(name, 'Operator', { admin: true });
+  const c = t.client();
+  const r = await c.post('/api/login', { username: name, password: a.passphrase });
+  assert.equal(r.status, 200, 'admin can log in');
+  return { c, id: a.id, passphrase: a.passphrase };
+}
+const idOf = (t, username) => t.db.prepare('SELECT id FROM accounts WHERE username = ?').get(username)?.id;
+
+test('A1 [SR16] an admin cannot be created over HTTP, and a normal user gets 404 on every admin route (anonymous gets 401)', async () => {
+  const t = await boot();
+  try {
+    const reg = await t.client().post('/api/register', { invite: 'USS-PRACTICE', username: 'sneaky1', display: 'Sneaky', admin: true, is_admin: 1 });
+    assert.equal(reg.status, 201);
+    assert.equal(t.db.prepare('SELECT is_admin FROM accounts WHERE username = ?').get('sneaky1').is_admin, 0);
+    const u = await practiceUser(t);
+    const me = (await u.c.get('/api/me')).data;
+    assert.equal(me.admin, false);
+    const adminRoutes = t.app.routes.filter((r) => r.admin);
+    assert.equal(adminRoutes.length, 6, 'exactly these admin routes exist: a new one must be added here on purpose');
+    const anon = t.client();
+    for (const r of adminRoutes) {
+      const p = r.path.replace(':id', 'a'.repeat(32));
+      const body = r.method === 'GET' ? undefined : {};
+      assert.equal((await anon.raw(r.method, p, body)).status, 401, `${r.method} ${r.path} anonymous`);
+      assert.equal((await u.c.raw(r.method, p, body)).status, 404, `${r.method} ${r.path} as a normal user`);
+    }
+  } finally { await t.stop(); }
+});
